# Stage 1: Build .NET API
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS api-build
WORKDIR /src
COPY ["Billing SCHR/BillingSCHR/ODULink.csproj", "BillingSCHR/"]
RUN dotnet restore "BillingSCHR/ODULink.csproj"
COPY ["Billing SCHR/BillingSCHR/", "BillingSCHR/"]
RUN dotnet publish "BillingSCHR/ODULink.csproj" -c Release -o /app

# Stage 2: Build React admin panel
FROM node:22-alpine AS admin-build
WORKDIR /admin
COPY ["Billing SCHR/BillingSCHR/admin-panel/package.json", "Billing SCHR/BillingSCHR/admin-panel/package-lock.json", "./"]
RUN npm install
COPY ["Billing SCHR/BillingSCHR/admin-panel/", "./"]
RUN npm run build

# Stage 3: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=api-build /app .
COPY --from=admin-build /admin/dist wwwroot/admin
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "ODULink.dll"]
